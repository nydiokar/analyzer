# App Configuration
NODE_ENV=environment
LOG_LEVEL=info
QUIET_MODE=false # Set to true to further reduce logs to only essential messages 
PNL_DEBUG_LOGS=false

# Feature flags
DISABLE_HOLDER_PROFILE_SNAPSHOT_CACHE=false
DISABLE_BEHAVIOR_CACHE=fasle

# Enables mapper.test to work with real txs - to automatically populate the missing json data in OUTPUT_DIR auto
UPDATE_FIXTURES=1

# Data Storage
DATA_DIR=./data
STORAGE_FORMAT=json # Options: json, csv

# Rate Limiting
MAX_REQUESTS_PER_MINUTE=50 # CoinGecko free tier limit
RATE_LIMIT_BUFFER=5 # Buffer to prevent hitting limits

# Telegram Bot Configuration for General crypto
TELEGRAM_BOT_TOKEN_GENERAL=your_bot_token_here
TELEGRAM_CHAT_ID_GENERAL=your_chat_id_here

# Telegram Bot Configuration for Wallet analysis
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here


# Telegram Bot Configuration for Intel API
INTEL_BOT_TOKEN=your_bot_token_here
INTEL_API_KEY= your_api_key_here
INTEL_BOT_ALLOWED_USER_IDS=your_user_id_here

# Helius API Configuration
HELIUS_API_KEY=your_helius_api_key_here
HELIUS_WEBHOOK_SECRET=your_helius_webhook_secret_here

# Payment Configuration
TREASURY_WALLET_ADDRESS=your_treasury_wallet_address_here
HELIUS_PAYMENT_WEBHOOK_SECRET=your_helius_payment_webhook_secret_here
FREE_CREDITS_ON_SIGNUP=500

# Optional: Separate Helius API key for metadata enrichment
# If not provided, falls back to HELIUS_API_KEY
# Useful to isolate rate limits: main key for transactions, metadata key for token enrichment
# Free tier: 1M credits/month, 2 req/s for DAS APIs (enough for 100k token enrichments/month)
HELIUS_METADATA_API_KEY=your_helius_metadata_api_key_here
DATABASE_URL="postgresql://postgres:mypassword123@localhost:5432/your_db_name"

# Redis Configuration (for queues and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL="redis://:YOUR_PASSWORD_HERE@127.0.0.1:6379"

# Helius V2 APIs
# Token accounts V2 pagination (cursor-based, up to 10k items per page)
ENABLE_HELIUS_V2_PAGINATION=false
HELIUS_V2_PAGE_LIMIT=5000
# NOTE: Incremental fetch (changedSinceSlot) is always active - no flag needed

# Transaction signature fetching V2 (getTransactionsForAddress)
# ⚠️ NOT RECOMMENDED: Costs 100 credits/page vs 0 for legacy, saves only ~100ms
# Only enable if you need server-side filtering or Helius deprecates getSignaturesForAddress
ENABLE_HELIUS_TX_FOR_ADDRESS_SIGNATURES=false   # Keep as false by default so we don't enable the expensive fetching
HELIUS_TX_FOR_ADDRESS_PAGE_LIMIT=1000           # Max 1000 signatures per page
HELIUS_TX_FOR_ADDRESS_USE_STATUS_SUCCEEDED=true # Filter to succeeded txs for newer sync
HELIUS_SIGNATURE_SAFETY_MULTIPLIER=5 # Multiplies pagination limit of requested maxSignatures to avoid overshoot 


# -----------------------------------------------------------------------------
# EVM — Alchemy API (Ethereum primary)
# Free key at https://dashboard.alchemy.com — no credit card required
# One key covers all chains (Ethereum, Arbitrum, Base)
# -----------------------------------------------------------------------------
ALCHEMY_API_KEY=your_alchemy_api_key_here
EVM_CHAIN=ethereum

# ======================================
# Analyzer - Example Environment Variables
# Copy this file to .env and adjust as needed
# ======================================

# --- Queue/Job Timeouts (milliseconds) ---
# Per-job processing timeouts used by processors. Increase for heavy loads.
SYNC_WALLET_TIMEOUT_MS=600000                 # 10 minutes
ANALYZE_PNL_TIMEOUT_MS=300000                 # 5 minutes
ANALYZE_BEHAVIOR_TIMEOUT_MS=300000            # 5 minutes
CALCULATE_SIMILARITY_TIMEOUT_MS=1800000       # 30 minutes
ENRICH_TOKEN_BALANCES_TIMEOUT_MS=1200000      # 20 minutes
DASHBOARD_WALLET_ANALYSIS_TIMEOUT_MS=900000   # 15 minutes

# --- Execution/Processing Knobs ---
SIMILARITY_LAB_MAX_SIGNATURES=500
DASHBOARD_MAX_SIGNATURES=5001
WALLET_SYNC_CONCURRENCY=3
BATCH_PROCESSING_TIMEOUT_MS=1800000           # 30 minutes
FAILURE_THRESHOLD=0.8                         # 0..1
RETRY_ATTEMPTS=1
RETRY_DELAY_MS=2000                           # ms
DASHBOARD_JOB_DEFAULT_TIMEOUT_MINUTES=15

# --- Frontend/WebSocket (optional; used by dashboard) ---
# Uncomment and set if you need to override defaults in the dashboard app
# NEXT_PUBLIC_WEBSOCKET_URL=https://sova-intel.duckdns.org
# NEXT_PUBLIC_SOCKET_TRANSPORTS=polling,websocket
# NEXT_PUBLIC_SOCKET_UPGRADE=true
# NEXT_PUBLIC_SOCKET_NONCE=false
# NEXT_PUBLIC_SOCKET_FORCE_NEW=false

# Mint participants flow defaults (custom function )
MINT_PARTICIPANTS_WINDOW_SECONDS=7
MINT_PARTICIPANTS_LIMIT_BUYERS=20
MINT_PARTICIPANTS_TX_COUNT_LIMIT=500
MINT_PARTICIPANTS_CANDIDATE_WINDOW=300
MINT_PARTICIPANTS_CREATION_SCAN=full
MINT_PARTICIPANTS_CREATION_SKIP_IF_TOKEN_ACCOUNTS_OVER=10000
MINT_PARTICIPANTS_OUTPUT=jsonl
# MINT_PARTICIPANTS_OUTFILE=analyses/mint_participants/index.jsonl
MINT_PARTICIPANTS_VERBOSE=false
MINT_PARTICIPANTS_EXCLUDE_WALLETS=wallet1,wallet2
MINT_PARTICIPANTS_TRACKED_WALLET=


# --- JWT Authentication Configuration ---
# CRITICAL: Generate a secure random secret using: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
# Must be at least 64 characters with high entropy (mix of letters, numbers, symbols)
################# NEVER use the default value below in production! #################
JWT_SECRET=REPLACE_THIS_WITH_SECURE_STRING
JWT_EXPIRES_IN=60m
# Refresh token TTLs (days)
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_TOKEN_ABSOLUTE_TTL_DAYS=30

# Password security enhancement - adds extra randomness to password hashing
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PASSWORD_PEPPER=REPLACE_THIS_WITH_SECURE_RANDOM_64_CHAR_HEX_STRING_FOR_PASSWORD_PEPPER

# --- Authentication Security Settings ---
AUTH_COOKIE_MODE=false              # Set to 'true' for httpOnly cookie mode (recommended for production)
AUTH_COOKIE_NAME=your_app_name.sid       # Cookie name when using cookie mode
AUTH_COOKIE_SECURE=true            # Require HTTPS for cookies (set false for development only)

# --- Frontend Authentication Storage (Dashboard) ---
# Storage mode for authentication tokens in the frontend
# Options: 'cookie' (recommended for production), 'memory' (high security, lost on refresh), 'localStorage' (dev only)
NEXT_PUBLIC_AUTH_COOKIE_MODE=false
NEXT_PUBLIC_AUTH_MEMORY_MODE=false

# --- Security Monitoring & Alerting ---
# Alert thresholds (events per hour)
SECURITY_CRITICAL_THRESHOLD=4
SECURITY_HIGH_THRESHOLD=10
SECURITY_SUSPICIOUS_IPS_THRESHOLD=5
SECURITY_RATE_LIMIT_THRESHOLD=20
SECURITY_FAILED_LOGINS_THRESHOLD=15

# Notification channels (optional)
# SECURITY_WEBHOOK_URL=https://your-webhook-url.com/security

# --- Email Verification Configuration ---
# Email delivery (choose one provider)
# MAIL_PROVIDER=resend                # or "smtp"
# MAIL_FROM=noreply@yourcompany.com   # used by both providers

# Resend (recommended for fast setup)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# MAIL_WEBHOOK_SECRET=super-secret    # optional: protects /webhooks/email/resend

# SMTP fallback
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM_EMAIL=noreply@yourcompany.com

# General app info for emails
# APP_NAME=Sova Intel
# FRONTEND_URL=http://localhost:3000
