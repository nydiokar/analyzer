generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  address                      String                  @id @unique
  firstProcessedTimestamp      Int?
  newestProcessedSignature     String?
  newestProcessedTimestamp     Int?
  lastSuccessfulFetchTimestamp DateTime?
  analyzedTimestampStart       Int?
  analyzedTimestampEnd         Int?
  classification               String?                 @default("unknown")
  classificationConfidence     Float?
  classificationUpdatedAt      DateTime?
  classificationMethod         String?
  isVerifiedBot                Boolean                 @default(false)
  botType                      String?
  botPatternTags               Json?
  knownLabel                   String?
  knownType                    String?
  activityLogs                 ActivityLog[]           @relation("WalletActivityLogs")
  AnalysisResult               AnalysisResult[]
  HolderProfileSnapshot        HolderProfileSnapshot[]
  TokenLot                     TokenLot[]
  favoritedBy                  UserFavoriteWallet[]
  behaviorProfile              WalletBehaviorProfile?
  walletNotes                  WalletNote[]
  pnlSummary                   WalletPnlSummary?
  kolProfile                   KolProfile?

  @@index([classification])
  @@index([classificationConfidence])
  @@index([isVerifiedBot])
  @@index([knownType])
}

// ---------------------------------------------------------------------------
// KOL Registry — Key Opinion Leaders with public social identity
// Linked 1:1 to Wallet. Wallets with knownType='KOL' are analyzed normally
// (not skipped), but their identity is surfaced in API responses.
// ---------------------------------------------------------------------------
model KolProfile {
  walletAddress String   @id
  name          String
  twitter       String?
  telegram      String?
  importedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt
  wallet        Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@index([name])
}

model HeliusTransactionCache {
  signature String   @id
  timestamp Int
  fetchedAt DateTime @default(now())

  @@index([timestamp])
}

model SignificantBuyersCache {
  id                String   @id @default(cuid())
  mint              String
  startBlockTime    Int
  endBlockTime      Int
  walletAddresses   String
  totalTransactions Int
  processedAt       DateTime @default(now())
  transactions      String

  @@unique([mint, startBlockTime, endBlockTime], name: "mint_startBlockTime_endBlockTime")
  @@index([mint])
  @@index([processedAt])
}

model SwapAnalysisInput {
  id                  Int    @id @default(autoincrement())
  walletAddress       String
  signature           String
  timestamp           Int
  mint                String
  amount              Float
  direction           String
  associatedSolValue  Float
  associatedUsdcValue Float?
  interactionType     String
  feeAmount           Float?
  feePercentage       Float?
  // --- Market Context (enrichment) ---
  solPriceUsd    Float?     // SOL/USD price at time of trade
  usdValue       Float?     // total USD value of the trade (associatedSolValue × solPriceUsd)
  tokenPriceUsd  Float?     // per-token USD price: usdValue / amount
  marketCapUsd   Float?     // fully diluted: tokenPriceUsd × totalSupply
  mcapBucket     String?    // "nano" | "ultra-micro" | "micro" | "small" | "mid" | "large" | "mega"
  enrichedAt     DateTime?  // when this row was enriched (null = not yet)

  @@unique([signature, mint, direction, amount], name: "signature_mint_direction_amount")
  @@index([walletAddress, timestamp])
  @@index([mint])
}

model AnalysisResult {
  id                          Int       @id @default(autoincrement())
  walletAddress               String
  tokenAddress                String
  totalAmountIn               Float
  totalAmountOut              Float
  netAmountChange             Float
  totalSolSpent               Float
  totalSolReceived            Float
  totalFeesPaidInSol          Float?
  netSolProfitLoss            Float?
  transferCountIn             Int
  transferCountOut            Int
  firstTransferTimestamp      Int?
  lastTransferTimestamp       Int?
  isValuePreservation         Boolean?
  estimatedPreservedValue     Float?
  preservationType            String?
  currentRawBalance           String?
  currentUiBalance            Float?
  currentUiBalanceString      String?
  balanceDecimals             Int?
  balanceFetchedAt            DateTime?
  updatedAt                   DateTime  @default(now()) @updatedAt
  currentHoldingsValueSol     Float?
  currentHoldingsValueUsd     Float?
  currentHoldingsCostBasisSol Float?
  hasIncompleteHistory        Boolean?  @default(false)
  realizedPnlSol              Float?
  totalPnlSol                 Float?
  unrealizedPnlSol            Float?
  avgEntryMcap                Float?    // volume-weighted avg marketCapUsd across buy trades for this token
  avgEntryMcapBucket          String?   // classified bucket of avgEntryMcap
  typicalEntryMcapUsd         Float?    // weighted median marketCapUsd across buy trades for this token
  entryMcapP25Usd             Float?    // weighted 25th percentile marketCapUsd across buy trades for this token
  entryMcapP75Usd             Float?    // weighted 75th percentile marketCapUsd across buy trades for this token
  avgExitMcap                 Float?    // volume-weighted avg marketCapUsd across sell trades for this token
  avgExitMcapBucket           String?   // classified bucket of avgExitMcap
  typicalExitMcapUsd          Float?    // weighted median marketCapUsd across sell trades for this token
  exitMcapP25Usd              Float?    // weighted 25th percentile marketCapUsd across sell trades for this token
  exitMcapP75Usd              Float?    // weighted 75th percentile marketCapUsd across sell trades for this token
  wallet                      Wallet    @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@unique([walletAddress, tokenAddress])
  @@index([walletAddress])
  @@index([tokenAddress])
  @@index([lastTransferTimestamp])
  @@index([netSolProfitLoss])
}

model TokenLot {
  id                Int      @id @default(autoincrement())
  walletAddress     String
  tokenAddress      String
  amountBought      Decimal  @db.Decimal(38, 18)
  costBasisSol      Decimal  @db.Decimal(38, 18)
  amountRemaining   Decimal  @db.Decimal(38, 18)
  purchaseTimestamp Int
  status            String
  sourceSignature   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  entryPriceUsd     Float?   // per-token USD price at time of buy (tokenPriceUsd from enriched row)
  entryMcapUsd      Float?   // market cap at time of buy (marketCapUsd from enriched row)
  entryMcapBucket   String?  // classified bucket of entryMcapUsd
  costBasisUsd      Float?   // costBasisSol × solPriceUsd at time of buy
  wallet            Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@index([walletAddress, tokenAddress, purchaseTimestamp])
}

model WalletPnlSummary {
  id                                Int                 @id @default(autoincrement())
  walletAddress                     String              @unique
  totalVolume                       Float
  totalFees                         Float
  realizedPnl                       Float
  unrealizedPnl                     Float
  netPnl                            Float
  stablecoinNetFlow                 Float
  averageSwapSize                   Float
  profitableTokensCount             Int
  unprofitableTokensCount           Int
  totalExecutedSwapsCount           Int
  averageRealizedPnlPerExecutedSwap Float
  realizedPnlToTotalVolumeRatio     Float
  totalSignaturesProcessed          Int
  overallFirstTimestamp             Int?
  overallLastTimestamp              Int?
  updatedAt                         DateTime            @updatedAt
  currentSolBalance                 Float?
  solBalanceFetchedAt               DateTime?
  profitableTradesCount             Int                 @default(0)
  totalIndividualTradesCount        Int                 @default(0)
  totalVolumeUsd                    Float?              // Σ usdValue across all enriched swap rows for wallet
  realizedPnlUsd                    Float?              // per-mint: Σ out usdValue − Σ in usdValue, summed across all mints
  unrealizedPnlUsd                  Float?              // open lots costBasisUsd vs current holdings USD value
  netPnlUsd                         Float?              // realizedPnlUsd + unrealizedPnlUsd
  advancedStats                     AdvancedTradeStats?
  wallet                            Wallet              @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
}

model AdvancedTradeStats {
  id                           Int              @id @default(autoincrement())
  walletPnlSummaryId           Int              @unique
  medianPnlPerToken            Float
  trimmedMeanPnlPerToken       Float
  tokenWinRatePercent          Float
  standardDeviationPnl         Float
  profitConsistencyIndex       Float
  weightedEfficiencyScore      Float
  averagePnlPerDayActiveApprox Float
  firstTransactionTimestamp    Int?
  lastTransactionTimestamp     Int?
  updatedAt                    DateTime         @updatedAt
  walletPnlSummary             WalletPnlSummary @relation(fields: [walletPnlSummaryId], references: [id], onDelete: Cascade)
}

model WalletBehaviorProfile {
  id                                 Int      @id @default(autoincrement())
  walletAddress                      String   @unique
  buySellRatio                       Float
  buySellSymmetry                    Float
  averageFlipDurationHours           Float
  medianHoldTime                     Float
  sequenceConsistency                Float
  flipperScore                       Float
  uniqueTokensTraded                 Int
  tokensWithBothBuyAndSell           Int
  totalTradeCount                    Int
  totalBuyCount                      Int
  totalSellCount                     Int
  completePairsCount                 Int
  averageTradesPerToken              Float
  tradingTimeDistribution            Json
  percentTradesUnder1Hour            Float
  percentTradesUnder4Hours           Float
  tradingStyle                       String
  confidenceScore                    Float
  tradingFrequency                   Json
  tokenPreferences                   Json
  riskMetrics                        Json
  reentryRate                        Float
  percentageOfUnpairedTokens         Float
  sessionCount                       Int
  avgTradesPerSession                Float
  activeTradingPeriods               Json
  averageSessionStartHour            Float
  averageSessionDurationMinutes      Float
  firstTransactionTimestamp          Int?
  lastTransactionTimestamp           Int?
  activeTradingDays                  Int?
  updatedAt                          DateTime @updatedAt
  holdTimeTokenMap                   Json?
  enrichedHoldTimeDistribution       Json?
  flowPattern                        String?
  medianActiveHoldingHours           Float?
  speedCategory                      String?
  strategyType                       String?
  tokensWithOnlyBuys                 Int      @default(0)
  velocityScore                      Int?
  averageCurrentHoldingDurationHours Float?
  exitPattern                        String?
  medianCurrentHoldingDurationHours  Float?
  percentOfValueInCurrentHoldings    Float?
  medianCompletedHoldTimeHours       Float?
  preferredMcapBucket                String?  // bucket where most buy-side usdValue was deployed
  avgEntryMcap                       Float?   // volume-weighted avg marketCapUsd across all buy trades
  mcapDistribution                   Json?    // { nano: 0.4, micro: 0.3, ... } fraction of buy volume per bucket
  mcapBucketPnl                      Json?    // { nano: { realizedPnlSol: 1.2, tradeCount: 12, winRate: 0.67 }, ... }
  typicalEntryMcapUsd                Float?   // weighted median marketCapUsd across all buy trades
  entryMcapP25Usd                    Float?   // weighted 25th percentile marketCapUsd across all buy trades
  entryMcapP75Usd                    Float?   // weighted 75th percentile marketCapUsd across all buy trades
  dominantEntryMcapBucket            String?  // bucket with highest buy-side usdValue share
  dominantEntryMcapBucketShare       Float?   // share of buy-side usdValue in dominantEntryMcapBucket
  entryMcapDistributionByCount       Json?    // { '10-20k': 0.42, ... } fraction of buy trade count per bucket
  entryMcapSampleSizeBuys            Int?     // number of eligible buy-side rows contributing to mcap profile
  entryMcapSampleSizeTokens          Int?     // number of distinct mints contributing to mcap profile
  wallet                             Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
  @@index([strategyType])
  @@index([speedCategory])
}

model HolderProfileSnapshot {
  id            Int      @id @default(autoincrement())
  walletAddress String
  tokenMint     String?
  analysisMode  String
  holderRank    Int?
  supplyPercent Float?
  topN          Int?
  jobId         String?
  requestId     String?
  computedAt    DateTime @default(now())
  profile       Json
  metadata      Json?
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([tokenMint, computedAt])
  @@index([walletAddress, tokenMint, computedAt])
}

model AnalysisRun {
  id                   Int      @id @default(autoincrement())
  walletAddress        String
  serviceInvoked       String
  runTimestamp         DateTime @default(now())
  status               String
  inputDataStartTs     Int?
  inputDataEndTs       Int?
  signaturesConsidered Int?
  durationMs           Int?
  errorMessage         String?
  notes                String?

  @@index([walletAddress, runTimestamp])
  @@index([serviceInvoked])
  @@index([status])
}

model User {
  id                  String                   @id @default(cuid())
  apiKey              String                   @unique
  description         String?
  isDemo              Boolean                  @default(false)
  isAdmin             Boolean                  @default(false)
  isAnalyst           Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  lastSeenAt          DateTime?
  isActive            Boolean                  @default(true)
  displayName         String?                  @unique
  email               String?                  @unique
  emailVerified       Boolean                  @default(false)
  lastLoginAt         DateTime?
  passwordHash        String?
  lastBulkImportAt    DateTime?
  activityLogs        ActivityLog[]
  apiKeys             ApiKey[]
  verificationTokens  EmailVerificationToken[]
  messages            Message[]
  passwordResetTokens PasswordResetToken[]
  favoriteWallets     UserFavoriteWallet[]
  userWatchedTokens   UserWatchedToken[]
  walletHunts         WalletHunt[]
  walletNotes         WalletNote[]
  registrationCode    RegistrationCode?
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]
  messageReadStates   MessageReadState[]
  tokenAlerts         TokenAlert[]
  alertNotifications  AlertNotification[]
  holderProfileShares HolderProfileShare[]

  @@index([lastBulkImportAt])
}

model RegistrationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  status      String    @default("active")
  description String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  usedByUserId String?  @unique
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  createdBy   String?
  usedBy      User?     @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  prefix      String
  keyHash     String
  userId      String
  description String?
  scopes      String?
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String?
  actionType        String
  timestamp         DateTime @default(now())
  requestParameters String?
  status            String
  durationMs        Int?
  errorMessage      String?
  sourceIp          String?
  walletAddress     String?
  user              User?    @relation(fields: [userId], references: [id])
  wallet            Wallet?  @relation("WalletActivityLogs", fields: [walletAddress], references: [address])

  @@index([userId])
  @@index([actionType])
  @@index([timestamp])
}

model MappingActivityLog {
  id                                 String   @id @default(cuid())
  walletAddress                      String
  timestamp                          DateTime @default(now())
  totalTransactionsReceived          Int
  transactionsSkippedError           Int
  transactionsSuccessfullyProcessed  Int
  analysisInputsGenerated            Int
  nativeSolTransfersProcessed        Int
  tokenTransfersProcessed            Int
  wsolTransfersProcessed             Int
  usdcTransfersProcessed             Int
  otherTokenTransfersProcessed       Int
  feePayerHeuristicApplied           Int
  feesCalculated                     Int
  eventMatcherAttempts               Int
  eventMatcherPrimaryMintsIdentified Int
  eventMatcherConsistentSolFound     Int
  eventMatcherConsistentUsdcFound    Int
  eventMatcherAmbiguous              Int
  eventMatcherNoConsistentValue      Int
  splToSplSwapDetections             Int
  associatedValueFromSplToSpl        Int
  associatedValueFromEventMatcher    Int
  associatedValueFromTotalMovement   Int
  associatedValueFromNetChange       Int
  smallOutgoingHeuristicApplied      Int
  skippedDuplicateRecordKey          Int
  countByInteractionType             Json
  unknownTxSkippedNoJito             Int      @default(0)

  @@index([walletAddress])
  @@index([timestamp])
}

model WalletNote {
  id            String   @id @default(cuid())
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  walletAddress String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
  @@index([userId])
  @@index([createdAt])
}

model UserFavoriteWallet {
  userId        String
  walletAddress String
  createdAt     DateTime  @default(now())
  collections   String?
  lastViewedAt  DateTime?
  metadata      Json?
  nickname      String?
  tags          String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet    @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@id([userId, walletAddress])
  @@index([userId])
  @@index([walletAddress])
  @@index([lastViewedAt])
}

model TokenInfo {
  tokenAddress            String         @id @unique
  name                    String?
  symbol                  String?
  imageUrl                String?
  websiteUrl              String?
  twitterUrl              String?
  telegramUrl             String?
  marketCapUsd            Float?
  liquidityUsd            Float?
  pairCreatedAt           BigInt?
  fdv                     Float?
  volume24h               Float?
  priceUsd                String?
  dexscreenerUpdatedAt    DateTime?
  fetchedAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  onchainName             String?
  onchainSymbol           String?
  onchainDescription      String?
  onchainImageUrl         String?
  onchainCreator          String?
  onchainMetadataUri      String?
  onchainBasicFetchedAt   DateTime?
  onchainWebsiteUrl       String?
  onchainTwitterUrl       String?
  onchainTelegramUrl      String?
  onchainDiscordUrl       String?
  onchainSocialsFetchedAt DateTime?
  metadataSource          String?
  totalSupply             Float?         // SPL token total supply (uiAmount); immutable for most memecoins
  TokenTag                TokenTag[]
  WatchedToken            WatchedToken[]
  userWatchedTokens       UserWatchedToken[]
  tokenAlerts             TokenAlert[]

  @@index([name])
  @@index([symbol])
  @@index([marketCapUsd])
  @@index([liquidityUsd])
  @@index([pairCreatedAt])
}

model Message {
  id              String            @id @default(cuid())
  body            String
  authorUserId    String?
  source          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  isPinned        Boolean           @default(false)
  parentId        String?
  author          User?             @relation(fields: [authorUserId], references: [id])
  parent          Message?          @relation("MessageThread", fields: [parentId], references: [id])
  replies         Message[]         @relation("MessageThread")
  mentions        MessageMention[]
  reactions       MessageReaction[]
  revisions       MessageRevision[]

  @@index([createdAt, id])
}

model MessageMention {
  id        String  @id @default(cuid())
  messageId String
  kind      String
  refId     String?
  rawValue  String
  metaJson  Json?
  Message   Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@index([kind, refId])
}

model MessageReaction {
  messageId String
  type      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Message   Message  @relation(fields: [messageId], references: [id])

  @@id([messageId, type])
  @@index([type])
}

model MessageRevision {
  id        String   @id @default(cuid())
  messageId String
  body      String
  editedAt  DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id])
}

model Tag {
  id       String     @id @default(cuid())
  name     String     @unique
  type     String
  TokenTag TokenTag[]
}

model TokenTag {
  tokenAddress String
  tagId        String
  source       String
  confidence   Float     @default(1.0)
  createdAt    DateTime  @default(now())
  Tag          Tag       @relation(fields: [tagId], references: [id])
  TokenInfo    TokenInfo @relation(fields: [tokenAddress], references: [tokenAddress])

  @@id([tokenAddress, tagId])
  @@index([tagId])
}

model WatchedToken {
  id           String    @id @default(cuid())
  tokenAddress String
  list         String
  createdAt    DateTime  @default(now())
  createdBy    String?
  TokenInfo    TokenInfo @relation(fields: [tokenAddress], references: [tokenAddress])

  @@unique([tokenAddress, list])
}

model UserWatchedToken {
  userId       String
  tokenAddress String
  createdAt    DateTime  @default(now())
  tags         String[]  @default([])
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenInfo    TokenInfo @relation(fields: [tokenAddress], references: [tokenAddress], onDelete: Cascade)

  @@id([userId, tokenAddress])
  @@index([tokenAddress])
  @@index([createdAt])
}

model TokenAccountWatermark {
  id          String   @id @default(cuid())
  ownerPubkey String
  filterKey   String   // "program:spl-token", "program:token-2022", or "mint:{address}"
  lastSlot    Int
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([ownerPubkey, filterKey])
  @@index([ownerPubkey])
  @@index([updatedAt])
}

model WalletHunt {
  id            String   @id @default(cuid())
  userId        String
  name          String
  createdAt     DateTime @default(now())
  lastVisitedAt DateTime @default(now())

  snapshots     WalletHuntSnapshot[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastVisitedAt])
}

model WalletHuntSnapshot {
  id         String   @id @default(cuid())
  huntId     String
  tokenMint  String
  sourceType String
  capturedAt DateTime @default(now())
  holders    String[]
  note       String?

  hunt       WalletHunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, tokenMint, sourceType])
  @@index([huntId])
}

// ---------------------------------------------------------------------------
// Credit ledger — append-only design
// Never mutate CreditBalance.credits directly; always go through
// CreditsService.topUp() / CreditsService.deduct() which wrap both writes
// in a Prisma transaction to ensure the audit trail is complete.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Payment infrastructure — Solana Pay credit pack purchases
// ---------------------------------------------------------------------------

model CreditPack {
  id        String  @id @default(cuid())
  name      String  // "Starter" | "Builder" | "Pro"
  credits   Int     // 1000 | 10000 | 100000
  priceUsdc Float   // 15 | 120 | 900
  active    Boolean @default(true)
}

model PaymentIntent {
  id                String    @id @default(cuid())
  userId            String
  packId            String
  credits           Int
  amountUsdc        Float
  /// "pending" | "confirmed" | "expired"
  status            String    @default("pending")
  solanaPayUrl      String
  destinationWallet String
  reference         String    @unique // unique keypair pubkey used by @solana/pay findReference()
  createdAt         DateTime  @default(now())
  expiresAt         DateTime
  confirmedAt       DateTime?
  txSignature       String?

  @@index([userId, status])
  @@index([status, expiresAt])
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  credits   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  /// Positive = credit added, negative = credit spent
  delta        Int
  /// e.g. "purchase" | "signup_bonus" | "endpoint:/wallets/.../behavior-analysis"
  reason       String
  /// Payment intent ID, job ID, or any external reference
  refId        String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Holdings Radar — analyst-gated wallet monitoring (pipeline-independent)
// ---------------------------------------------------------------------------

model RadarWallet {
  wallet    String    @id
  label     String?
  addedAt   DateTime  @default(now())
  isActive  Boolean   @default(true)
  addedBy   String?
}

model RadarHolding {
  id              String    @id @default(cuid())
  wallet          String
  tokenMint       String
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime
  uiBalance       Float
  usdValue        Float?
  acquiredAt      DateTime?
  isActiveHolding Boolean   @default(true)
  reviewStatus    String    @default("unreviewed")
  reviewedAt      DateTime?
  note            String?

  @@unique([wallet, tokenMint])
  @@index([wallet])
  @@index([firstSeenAt])
  @@index([reviewStatus])
  @@index([isActiveHolding])
}

// ---------------------------------------------------------------------------
// Telegram Bot Intel — per-invocation attribution log
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Shareable Analysis Results — frozen snapshots of holder-profiles runs
// ---------------------------------------------------------------------------

model HolderProfileShare {
  id           String    @id @default(cuid())
  snapshotJson Json
  tokenMint    String?
  tokenSymbol  String?
  topN         Int?
  createdAt    DateTime  @default(now())
  expiresAt    DateTime?
  createdBy    String?
  viewCount    Int       @default(0)
  user         User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([createdBy])
}

model TelegramBotLog {
  id             String   @id @default(cuid())
  telegramUserId String
  username       String?
  command        String   // 'hud' | 'holders' | 'profile'
  address        String   // wallet addr or mint
  creditCost     Int
  success        Boolean
  errorCode      String?
  createdAt      DateTime @default(now())

  @@index([telegramUserId])
  @@index([command])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Token Dashboard — read state, alerts, alert notifications
// ---------------------------------------------------------------------------

model MessageReadState {
  id         Int      @id @default(autoincrement())
  userId     String
  scope      String
  lastReadAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scope])
  @@index([scope])
}

model TokenAlert {
  id              String              @id @default(cuid())
  userId          String
  tokenAddress    String
  label           String?
  condition       Json
  isActive        Boolean             @default(true)
  channels        Json
  lastTriggeredAt DateTime?
  triggerCount    Int                 @default(0)
  cooldownMinutes Int                 @default(60)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  baselinePrice   String?
  notifications   AlertNotification[]
  tokenInfo       TokenInfo           @relation(fields: [tokenAddress], references: [tokenAddress], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([tokenAddress, isActive])
}

model AlertNotification {
  id          String     @id @default(cuid())
  alertId     String
  userId      String
  triggeredAt DateTime   @default(now())
  snapshot    Json
  delivered   Boolean    @default(false)
  isRead      Boolean    @default(false)
  readAt      DateTime?
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert       TokenAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([triggeredAt])
}

// ---------------------------------------------------------------------------
// Market Context — SOL/USD daily price cache (source: DeFiLlama, free)
// Stores one row per calendar day. Populated on startup, appended daily.
// ---------------------------------------------------------------------------
model SolDailyPrice {
  date      String   @id          // format: "YYYY-MM-DD" (UTC)
  priceUsd  Float                 // SOL/USD closing price for that day
  fetchedAt DateTime @default(now())
}
