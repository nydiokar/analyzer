generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Wallet {
  address                      String                  @id @unique
  firstProcessedTimestamp      Int?
  newestProcessedSignature     String?
  newestProcessedTimestamp     Int?
  lastSuccessfulFetchTimestamp DateTime?
  analyzedTimestampStart       Int?
  analyzedTimestampEnd         Int?
  classification               String?                 @default("unknown")
  classificationConfidence     Float?
  classificationUpdatedAt      DateTime?
  classificationMethod         String?
  isVerifiedBot                Boolean                 @default(false)
  botType                      String?
  botPatternTags               Json?
  knownLabel                   String?
  knownType                    String?
  activityLogs                 ActivityLog[]           @relation("WalletActivityLogs")
  AnalysisResult               AnalysisResult[]
  HolderProfileSnapshot        HolderProfileSnapshot[]
  TokenLot                     TokenLot[]
  favoritedBy                  UserFavoriteWallet[]
  behaviorProfile              WalletBehaviorProfile?
  walletNotes                  WalletNote[]
  pnlSummary                   WalletPnlSummary?

  @@index([classification])
  @@index([classificationConfidence])
  @@index([isVerifiedBot])
  @@index([knownType])
}

model HeliusTransactionCache {
  signature String   @id
  timestamp Int
  fetchedAt DateTime @default(now())

  @@index([timestamp])
}

model SignificantBuyersCache {
  id                String   @id @default(cuid())
  mint              String
  startBlockTime    Int
  endBlockTime      Int
  walletAddresses   String
  totalTransactions Int
  processedAt       DateTime @default(now())
  transactions      String

  @@unique([mint, startBlockTime, endBlockTime], name: "mint_startBlockTime_endBlockTime")
  @@index([mint])
  @@index([processedAt])
}

model SwapAnalysisInput {
  id                  Int    @id @default(autoincrement())
  walletAddress       String
  signature           String
  timestamp           Int
  mint                String
  amount              Float
  direction           String
  associatedSolValue  Float
  associatedUsdcValue Float?
  interactionType     String
  feeAmount           Float?
  feePercentage       Float?

  @@unique([signature, mint, direction, amount], name: "signature_mint_direction_amount")
  @@index([walletAddress, timestamp])
  @@index([mint])
}

model AnalysisResult {
  id                          Int       @id @default(autoincrement())
  walletAddress               String
  tokenAddress                String
  totalAmountIn               Float
  totalAmountOut              Float
  netAmountChange             Float
  totalSolSpent               Float
  totalSolReceived            Float
  totalFeesPaidInSol          Float?
  netSolProfitLoss            Float?
  transferCountIn             Int
  transferCountOut            Int
  firstTransferTimestamp      Int?
  lastTransferTimestamp       Int?
  isValuePreservation         Boolean?
  estimatedPreservedValue     Float?
  preservationType            String?
  currentRawBalance           String?
  currentUiBalance            Float?
  currentUiBalanceString      String?
  balanceDecimals             Int?
  balanceFetchedAt            DateTime?
  updatedAt                   DateTime  @default(now()) @updatedAt
  currentHoldingsValueSol     Float?
  currentHoldingsValueUsd     Float?
  currentHoldingsCostBasisSol Float?
  hasIncompleteHistory        Boolean?  @default(false)
  realizedPnlSol              Float?
  totalPnlSol                 Float?
  unrealizedPnlSol            Float?
  wallet                      Wallet    @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@unique([walletAddress, tokenAddress])
  @@index([walletAddress])
  @@index([tokenAddress])
  @@index([lastTransferTimestamp])
  @@index([netSolProfitLoss])
}

model TokenLot {
  id                Int      @id @default(autoincrement())
  walletAddress     String
  tokenAddress      String
  amountBought      Decimal  @db.Decimal(38, 18)
  costBasisSol      Decimal  @db.Decimal(38, 18)
  amountRemaining   Decimal  @db.Decimal(38, 18)
  purchaseTimestamp Int
  status            String
  sourceSignature   String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  wallet            Wallet   @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@index([walletAddress, tokenAddress, purchaseTimestamp])
}

model WalletPnlSummary {
  id                                Int                 @id @default(autoincrement())
  walletAddress                     String              @unique
  totalVolume                       Float
  totalFees                         Float
  realizedPnl                       Float
  unrealizedPnl                     Float
  netPnl                            Float
  stablecoinNetFlow                 Float
  averageSwapSize                   Float
  profitableTokensCount             Int
  unprofitableTokensCount           Int
  totalExecutedSwapsCount           Int
  averageRealizedPnlPerExecutedSwap Float
  realizedPnlToTotalVolumeRatio     Float
  totalSignaturesProcessed          Int
  overallFirstTimestamp             Int?
  overallLastTimestamp              Int?
  updatedAt                         DateTime            @updatedAt
  currentSolBalance                 Float?
  solBalanceFetchedAt               DateTime?
  profitableTradesCount             Int                 @default(0)
  totalIndividualTradesCount        Int                 @default(0)
  advancedStats                     AdvancedTradeStats?
  wallet                            Wallet              @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
}

model AdvancedTradeStats {
  id                           Int              @id @default(autoincrement())
  walletPnlSummaryId           Int              @unique
  medianPnlPerToken            Float
  trimmedMeanPnlPerToken       Float
  tokenWinRatePercent          Float
  standardDeviationPnl         Float
  profitConsistencyIndex       Float
  weightedEfficiencyScore      Float
  averagePnlPerDayActiveApprox Float
  firstTransactionTimestamp    Int?
  lastTransactionTimestamp     Int?
  updatedAt                    DateTime         @updatedAt
  walletPnlSummary             WalletPnlSummary @relation(fields: [walletPnlSummaryId], references: [id], onDelete: Cascade)
}

model WalletBehaviorProfile {
  id                                 Int      @id @default(autoincrement())
  walletAddress                      String   @unique
  buySellRatio                       Float
  buySellSymmetry                    Float
  averageFlipDurationHours           Float
  medianHoldTime                     Float
  sequenceConsistency                Float
  flipperScore                       Float
  uniqueTokensTraded                 Int
  tokensWithBothBuyAndSell           Int
  totalTradeCount                    Int
  totalBuyCount                      Int
  totalSellCount                     Int
  completePairsCount                 Int
  averageTradesPerToken              Float
  tradingTimeDistribution            Json
  percentTradesUnder1Hour            Float
  percentTradesUnder4Hours           Float
  tradingStyle                       String
  confidenceScore                    Float
  tradingFrequency                   Json
  tokenPreferences                   Json
  riskMetrics                        Json
  reentryRate                        Float
  percentageOfUnpairedTokens         Float
  sessionCount                       Int
  avgTradesPerSession                Float
  activeTradingPeriods               Json
  averageSessionStartHour            Float
  averageSessionDurationMinutes      Float
  firstTransactionTimestamp          Int?
  lastTransactionTimestamp           Int?
  updatedAt                          DateTime @updatedAt
  holdTimeTokenMap                   Json?
  enrichedHoldTimeDistribution       Json?
  flowPattern                        String?
  medianActiveHoldingHours           Float?
  speedCategory                      String?
  strategyType                       String?
  tokensWithOnlyBuys                 Int      @default(0)
  velocityScore                      Int?
  averageCurrentHoldingDurationHours Float?
  exitPattern                        String?
  medianCurrentHoldingDurationHours  Float?
  percentOfValueInCurrentHoldings    Float?
  medianCompletedHoldTimeHours       Float?
  wallet                             Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
  @@index([strategyType])
  @@index([speedCategory])
}

model HolderProfileSnapshot {
  id            Int      @id @default(autoincrement())
  walletAddress String
  tokenMint     String?
  analysisMode  String
  holderRank    Int?
  supplyPercent Float?
  topN          Int?
  jobId         String?
  requestId     String?
  computedAt    DateTime @default(now())
  profile       Json
  metadata      Json?
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([tokenMint, computedAt])
  @@index([walletAddress, tokenMint, computedAt])
}

model AnalysisRun {
  id                   Int      @id @default(autoincrement())
  walletAddress        String
  serviceInvoked       String
  runTimestamp         DateTime @default(now())
  status               String
  inputDataStartTs     Int?
  inputDataEndTs       Int?
  signaturesConsidered Int?
  durationMs           Int?
  errorMessage         String?
  notes                String?

  @@index([walletAddress, runTimestamp])
  @@index([serviceInvoked])
  @@index([status])
}

model User {
  id                  String                   @id @default(cuid())
  apiKey              String                   @unique
  description         String?
  isDemo              Boolean                  @default(false)
  isAdmin             Boolean                  @default(false)
  createdAt           DateTime                 @default(now())
  lastSeenAt          DateTime?
  isActive            Boolean                  @default(true)
  displayName         String?                  @unique
  email               String?                  @unique
  emailVerified       Boolean                  @default(false)
  lastLoginAt         DateTime?
  passwordHash        String?
  lastBulkImportAt    DateTime?
  activityLogs        ActivityLog[]
  apiKeys             ApiKey[]
  verificationTokens  EmailVerificationToken[]
  Message             Message[]
  passwordResetTokens PasswordResetToken[]
  favoriteWallets     UserFavoriteWallet[]
  walletHunts         WalletHunt[]
  walletNotes         WalletNote[]
  registrationCode    RegistrationCode?
  creditBalance       CreditBalance?
  creditTransactions  CreditTransaction[]

  @@index([lastBulkImportAt])
}

model RegistrationCode {
  id          String    @id @default(cuid())
  code        String    @unique
  status      String    @default("active")
  description String?
  maxUses     Int       @default(1)
  usedCount   Int       @default(0)
  usedByUserId String?  @unique
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?
  createdBy   String?
  usedBy      User?     @relation(fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([code])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  prefix      String
  keyHash     String
  userId      String
  description String?
  scopes      String?
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([prefix])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ActivityLog {
  id                String   @id @default(cuid())
  userId            String?
  actionType        String
  timestamp         DateTime @default(now())
  requestParameters String?
  status            String
  durationMs        Int?
  errorMessage      String?
  sourceIp          String?
  walletAddress     String?
  user              User?    @relation(fields: [userId], references: [id])
  wallet            Wallet?  @relation("WalletActivityLogs", fields: [walletAddress], references: [address])

  @@index([userId])
  @@index([actionType])
  @@index([timestamp])
}

model MappingActivityLog {
  id                                 String   @id @default(cuid())
  walletAddress                      String
  timestamp                          DateTime @default(now())
  totalTransactionsReceived          Int
  transactionsSkippedError           Int
  transactionsSuccessfullyProcessed  Int
  analysisInputsGenerated            Int
  nativeSolTransfersProcessed        Int
  tokenTransfersProcessed            Int
  wsolTransfersProcessed             Int
  usdcTransfersProcessed             Int
  otherTokenTransfersProcessed       Int
  feePayerHeuristicApplied           Int
  feesCalculated                     Int
  eventMatcherAttempts               Int
  eventMatcherPrimaryMintsIdentified Int
  eventMatcherConsistentSolFound     Int
  eventMatcherConsistentUsdcFound    Int
  eventMatcherAmbiguous              Int
  eventMatcherNoConsistentValue      Int
  splToSplSwapDetections             Int
  associatedValueFromSplToSpl        Int
  associatedValueFromEventMatcher    Int
  associatedValueFromTotalMovement   Int
  associatedValueFromNetChange       Int
  smallOutgoingHeuristicApplied      Int
  skippedDuplicateRecordKey          Int
  countByInteractionType             Json
  unknownTxSkippedNoJito             Int      @default(0)

  @@index([walletAddress])
  @@index([timestamp])
}

model WalletNote {
  id            String   @id @default(cuid())
  content       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  walletAddress String
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  wallet        Wallet   @relation(fields: [walletAddress], references: [address])

  @@index([walletAddress])
  @@index([userId])
  @@index([createdAt])
}

model UserFavoriteWallet {
  userId        String
  walletAddress String
  createdAt     DateTime  @default(now())
  collections   String?
  lastViewedAt  DateTime?
  metadata      Json?
  nickname      String?
  tags          String?
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        Wallet    @relation(fields: [walletAddress], references: [address], onDelete: Cascade)

  @@id([userId, walletAddress])
  @@index([userId])
  @@index([walletAddress])
  @@index([lastViewedAt])
}

model TokenInfo {
  tokenAddress            String         @id @unique
  name                    String?
  symbol                  String?
  imageUrl                String?
  websiteUrl              String?
  twitterUrl              String?
  telegramUrl             String?
  marketCapUsd            Float?
  liquidityUsd            Float?
  pairCreatedAt           BigInt?
  fdv                     Float?
  volume24h               Float?
  priceUsd                String?
  dexscreenerUpdatedAt    DateTime?
  fetchedAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  onchainName             String?
  onchainSymbol           String?
  onchainDescription      String?
  onchainImageUrl         String?
  onchainCreator          String?
  onchainMetadataUri      String?
  onchainBasicFetchedAt   DateTime?
  onchainWebsiteUrl       String?
  onchainTwitterUrl       String?
  onchainTelegramUrl      String?
  onchainDiscordUrl       String?
  onchainSocialsFetchedAt DateTime?
  metadataSource          String?
  TokenTag                TokenTag[]
  WatchedToken            WatchedToken[]

  @@index([name])
  @@index([symbol])
  @@index([marketCapUsd])
  @@index([liquidityUsd])
  @@index([pairCreatedAt])
}

model Message {
  id              String            @id
  body            String
  authorUserId    String?
  source          String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  deletedAt       DateTime?
  isPinned        Boolean           @default(false)
  parentId        String?
  User            User?             @relation(fields: [authorUserId], references: [id])
  Message         Message?          @relation("MessageToMessage", fields: [parentId], references: [id])
  other_Message   Message[]         @relation("MessageToMessage")
  MessageMention  MessageMention[]
  MessageReaction MessageReaction[]
  MessageRevision MessageRevision[]

  @@index([createdAt, id])
}

model MessageMention {
  id        String  @id
  messageId String
  kind      String
  refId     String?
  rawValue  String
  metaJson  Json?
  Message   Message @relation(fields: [messageId], references: [id])

  @@index([messageId])
  @@index([kind, refId])
}

model MessageReaction {
  messageId String
  type      String
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime
  Message   Message  @relation(fields: [messageId], references: [id])

  @@id([messageId, type])
  @@index([type])
}

model MessageRevision {
  id        String   @id
  messageId String
  body      String
  editedAt  DateTime @default(now())
  Message   Message  @relation(fields: [messageId], references: [id])
}

model Tag {
  id       String     @id
  name     String     @unique
  type     String
  TokenTag TokenTag[]
}

model TokenTag {
  tokenAddress String
  tagId        String
  source       String
  confidence   Float     @default(1.0)
  createdAt    DateTime  @default(now())
  Tag          Tag       @relation(fields: [tagId], references: [id])
  TokenInfo    TokenInfo @relation(fields: [tokenAddress], references: [tokenAddress])

  @@id([tokenAddress, tagId])
  @@index([tagId])
}

model WatchedToken {
  id           String    @id
  tokenAddress String
  list         String
  createdAt    DateTime  @default(now())
  createdBy    String?
  TokenInfo    TokenInfo @relation(fields: [tokenAddress], references: [tokenAddress])

  @@unique([tokenAddress, list])
}

model TokenAccountWatermark {
  id          String   @id @default(cuid())
  ownerPubkey String
  filterKey   String   // "program:spl-token", "program:token-2022", or "mint:{address}"
  lastSlot    Int
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([ownerPubkey, filterKey])
  @@index([ownerPubkey])
  @@index([updatedAt])
}

model WalletHunt {
  id            String   @id @default(cuid())
  userId        String
  name          String
  createdAt     DateTime @default(now())
  lastVisitedAt DateTime @default(now())

  snapshots     WalletHuntSnapshot[]
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([lastVisitedAt])
}

model WalletHuntSnapshot {
  id         String   @id @default(cuid())
  huntId     String
  tokenMint  String
  sourceType String
  capturedAt DateTime @default(now())
  holders    String[]
  note       String?

  hunt       WalletHunt @relation(fields: [huntId], references: [id], onDelete: Cascade)

  @@unique([huntId, tokenMint, sourceType])
  @@index([huntId])
}

// ---------------------------------------------------------------------------
// Credit ledger — append-only design
// Never mutate CreditBalance.credits directly; always go through
// CreditsService.topUp() / CreditsService.deduct() which wrap both writes
// in a Prisma transaction to ensure the audit trail is complete.
// ---------------------------------------------------------------------------

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  credits   Int      @default(0)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditTransaction {
  id           String   @id @default(cuid())
  userId       String
  /// Positive = credit added, negative = credit spent
  delta        Int
  /// e.g. "purchase" | "signup_bonus" | "endpoint:/wallets/.../behavior-analysis"
  reason       String
  /// Payment intent ID, job ID, or any external reference
  refId        String?
  balanceAfter Int
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
