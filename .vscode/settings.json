{
    // ── Telemetry ────────────────────────────────────────────────────────────
    "telemetry.telemetryLevel": "off",
    "telemetry.editStats.enabled": false,
    "telemetry.feedback.enabled": false,

    // ── File explorer exclusions ─────────────────────────────────────────────
    "files.exclude": {
        "**/node_modules": true,
        "**/.git": true,
        "**/dist": true,
        "**/build": true,
        "**/coverage": true,
        "**/.next": true,
        "**/.nyc_output": true,
        "**/test-output": true,
        "**/e2e/reports": true,
        "**/.cache": true,
        "**/*.db": true,
        "**/*.db-journal": true,
        "**/*.db-shm": true,
        "**/*.db-wal": true,
        "**/tsconfig.tsbuildinfo": true
    },

    // ── Search exclusions ────────────────────────────────────────────────────
    "search.exclude": {
        "**/node_modules": true,
        "**/package-lock.json": true,
        "**/pnpm-lock.yaml": true,
        "**/dist": true,
        "**/build": true,
        "**/coverage": true,
        "**/.next": true,
        "**/.nyc_output": true,
        "**/test-output": true,
        "**/.cache": true,
        "**/seo-prompts": true,
        "**/llms-full.txt": true,
        "**/llms.txt": true,
        "**/.github/demos": true,
        "**/scripts/twitter": true,
        "**/*.map": true,
        "**/*.tsbuildinfo": true
    },

    // ── File watcher exclusions (biggest perf impact) ────────────────────────
    "files.watcherExclude": {
        "**/node_modules/**": true,
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/dist/**": true,
        "**/build/**": true,
        "**/coverage/**": true,
        "**/.next/**": true,
        "**/.nyc_output/**": true,
        "**/test-output/**": true,
        "**/.cache/**": true,
        "**/data/**": true,
        "**/logs/**": true,
        "**/backups/**": true,
        "**/analyses/**": true,
        "**/analysis_sessions/**": true,
        "**/analysis_reports/**": true,
        "**/debug_output/**": true,
        "**/active_alerts/**": true,
        "**/all_alerts/**": true,
        "**/.ai/context/sig_buyers/logs/**": true
    },

    // ── TypeScript ───────────────────────────────────────────────────────────
    "typescript.tsserver.maxTsServerMemory": 4096,
    "typescript.preferences.includePackageJsonAutoImports": "on",

    // ── Editor ───────────────────────────────────────────────────────────────
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    }
}
