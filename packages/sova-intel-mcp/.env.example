# ─── Sova Intel MCP — environment config ────────────────────────────────────
# Copy this file and rename it .env, or pass these as env vars in your MCP
# client config (Claude Desktop, Claude Code, Cursor, etc.)

# ── Auth (choose one) ────────────────────────────────────────────────────────

# API key mode (recommended — get a key at https://sova-intel.com)
SOVA_API_KEY=ak_your_key_here

# x402 mode — pay per call with Solana USDC, no API key needed
# SOVA_AUTH_MODE=x402
# SOLANA_PRIVATE_KEY=your_base58_encoded_keypair
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# ── Optional overrides ───────────────────────────────────────────────────────

# API base URL (default: https://api.sova-intel.com/api/v1)
# SOVA_BASE_URL=https://api.sova-intel.com/api/v1

# Auth mode: auto | apikey | x402 (default: auto)
# SOVA_AUTH_MODE=auto

# Async job polling — how long the MCP waits before returning mode:"queued"
# SOVA_POLL_INTERVAL_MS=5000       # ms between job status checks (default: 5000)
# SOVA_MAX_POLL_ATTEMPTS=9         # max attempts before queued handoff (default: 9)
# SOVA_WAIT_TIMEOUT_MS=45000       # total wait for standard tools (default: 45000)
# SOVA_DEEP_WAIT_TIMEOUT_MS=45000  # total wait for deep analysis (default: 45000)
