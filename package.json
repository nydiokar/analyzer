{
  "name": "Sova Intel",
  "version": "0.20.9",
  "description": "Solana wallet analysis - analyze behavior, decode strategies, profit smarter",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0 <25.0.0"
  },
  "scripts": {
    "start": "ts-node -r tsconfig-paths/register src/main.ts",
    "build": "npx tsc",
    "build:dashboard": "pnpm --prefix dashboard run build",
    "dev": "ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "dev:quiet": "cross-env QUIET_MODE=true ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "dev:verbose": "cross-env NODE_ENV=production ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "clean": "rimraf dist logs",
    "build:watch": "tsc --watch",
    "verify": "tsc --noEmit",
    "test:unit": "node --test -r ts-node/register -r tsconfig-paths/register src/core/services/helius-api-client.v2.test.ts src/core/services/helius-transaction-mapper.test.ts",
    "test:cache": "npx ts-node -r tsconfig-paths/register src/scripts/test-holder-profiles-cache.ts",
    "analyze": "npx ts-node -r tsconfig-paths/register src/scripts/helius-analyzer.ts",
    "similarity": "npx ts-node -r tsconfig-paths/register src/scripts/activityCorrelator.ts",
    "kpi-report": "npx ts-node -r tsconfig-paths/register src/scripts/kpi-comparison-report.ts",
    "start:wallet-analysis": "npx ts-node -r tsconfig-paths/register src/wallet_analysis/index.ts",
    "pm2:start:backend": "npx tsc && pm2 start ecosystem.backend.config.js --env production",
    "debug:mapper": "ts-node -r tsconfig-paths/register scripts/debug/debug-mapper.ts",
    "investigate:wallet": "ts-node -r tsconfig-paths/register scripts/debug/investigate-wallet-token.ts",
    "user:manage": "ts-node -r tsconfig-paths/register scripts/manage-users.ts",
    "apikey:manage": "ts-node -r tsconfig-paths/register scripts/manage-api-keys.ts",
    "test:integration": "npx ts-node -r tsconfig-paths/register src/queues/test-backend-integration.ts",
    "validate:deps": "npx ts-node -r tsconfig-paths/register scripts/validate-dependencies.ts",
    "clear:wallet": "npx ts-node -r tsconfig-paths/register scripts/clean-up/clear-wallet-data.ts",
    "clear:queues": "npx ts-node -r tsconfig-paths/register scripts/clean-up/clear-all-queues.ts",
    "clear:locks": "npx ts-node -r tsconfig-paths/register scripts/clean-up/clear-stale-locks.ts",
    "clear:cache": "npx ts-node -r tsconfig-paths/register scripts/clean-up/clear-wallet-cache.ts",
    "clean:logs": "npx ts-node -r tsconfig-paths/register scripts/clean-up/clean-logs.ts",
    "auth:reset-sessions": "npx ts-node -r tsconfig-paths/register scripts/clear-auth-sessions.ts",
    "god-mode:import": "npx ts-node -r tsconfig-paths/register scripts/god-mode-import-favorites.ts",
    "emergency-stop": "pm2 stop all && npm run clear:queues && npm run clear:locks",
    "reset-system": "npm run emergency-stop && pm2 start ecosystem.backend.config.js",
    "reset": "npm run build && pm2 restart all",
    "top-holders": "ts-node -r tsconfig-paths/register src/scripts/topTokenHolders.ts",
    "db:size": "npx ts-node -r tsconfig-paths/register scripts/scaling/check-db-size.ts",
    "lint": "eslint .",
    "lint:dashboard": "npm run lint --prefix dashboard",
    "extract-logs": "ts-node -r tsconfig-paths/register scripts/extract-log-statements.ts",
    "release": "bash scripts/release.sh",
    "release:patch": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major"
  },
  "keywords": [
    "crypto",
    "analysis",
    "wallet",
    "typescript",
    "data-verification"
  ],
  "author": "",
  "license": "ISC",
  "bin": {
    "mint-participants": "dist/scripts/mint-participants.js"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bullmq": "^11.0.3",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.2",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.2",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/terminus": "^11.0.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^11.1.6",
    "@nydiokar/autodoc": "^0.1.7",
