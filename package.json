    "@sentry/nestjs": "^10.30.0",
    "@sentry/profiling-node": "^10.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/csv-stringify": "^1.4.3",
    "@types/nodemailer": "^7.0.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.4.1",
    "bignumber.js": "^9.3.1",
    "bullmq": "^5.63.0",
    "chalk": "5.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compute-cosine-similarity": "^1.0.0",
    "cookies-next": "^6.1.0",
    "crypto-js": "^4.2.0",
    "csv-stringify": "^6.6.0",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "glob": "^10.0.0",
    "ioredis": "^5.8.2",
    "json-bigint": "^1.0.0",
    "nodemailer": "^7.0.6",
    "p-limit": "^7.1.1",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prom-client": "^15.1.3",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "react-wrap-balancer": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.5.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.7.0",
    "sonner": "^2.0.7",
    "sqlite3": "^5.1.7",
    "swagger-ui-express": "^5.0.1",
    "table": "^6.9.0",
    "telegraf": "^4.15.3",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@next/eslint-plugin-next": "^16.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/chai": "^5.2.2",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.5",
    "@types/json-bigint": "^1.0.4",
    "@types/lodash": "^4.17.18",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.15",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^11.0.0",
    "chai": "^5.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "mocha": "^11.7.2",
    "nodemon": "^3.1.0",
    "pm2": "^6.0.13",
    "prisma": "6.18.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.47.0"
  },
  "overrides": {
    "glob": "^11.0.0",
    "multer": "^2.0.2",
    "chalk": "5.3.0",
    "color-convert": "2.0.1",
    "color-name": "1.1.4",
    "is-core-module": "2.13.1",
    "error-ex": "1.3.2",
    "has-ansi": "5.0.1",
    "@nestjs/platform-express": {
      "multer": "^2.0.2"
    },
    "eslint": {
      "chalk": "^4.1.2"
    }
  },
  "packageManager": "pnpm@10.28.0+sha512.05df71d1421f21399e053fde567cea34d446fa02c76571441bfc1c7956e98e363088982d940465fd34480d4d90a0668bc12362f8aa88000a64e83d0b0e47be48"
}
